# This is Git's per-user configuration file.
[user]
# Please adapt and uncomment the following lines:
	name = Arham Jain
	email = 86415475+arhamj@users.noreply.github.com
	signingkey = /Users/arhmjn/.ssh/id_ed25519.pub
[url "git@github.com:"]
	insteadOf = https://github.com/
[core]
	excludesfile = /Users/arhmjn/.gitignore_global
[difftool "sourcetree"]
	cmd = opendiff \"$LOCAL\" \"$REMOTE\"
	path = 
[mergetool "sourcetree"]
	cmd = /Applications/Sourcetree.app/Contents/Resources/opendiff-w.sh \"$LOCAL\" \"$REMOTE\" -ancestor \"$BASE\" -merge \"$MERGED\"
	trustExitCode = true
[commit]
	template = /Users/arhmjn/.stCommitMsg
	gpgsign = true
[gpg]
	format = ssh
