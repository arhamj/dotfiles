# Choose Catppuccin Macchiato, Matrix, or Coolnight, then reload with Cmd+Shift+,.
# Neovim follows this selection. Palettes live in the themes directory.
theme = Catppuccin Macchiato

# font-family = MesloLGS Nerd Font Mono
font-family = JetBrainsMono Nerd Font Mono
font-size = 15
cursor-style = block
cursor-style-blink = false
window-padding-x = 8
window-padding-y = 8
window-theme = dark
macos-titlebar-style = hidden
macos-hidden = never
window-width = 120
window-height = 36
maximize = true
window-save-state = always

# Start in projects; new windows and splits follow the active shell's directory.
working-directory = ~/projects
window-inherit-working-directory = true
scrollback-limit = 50000000
# Keep the steady block cursor, with automatic zsh integration and SSH fallback.
shell-integration-features = no-cursor,ssh-env
macos-option-as-alt = left

# Quake-style drop-down on the screen receiving keyboard input.
# Global shortcuts require Ghostty's macOS Accessibility permission.
keybind = global:ctrl+backquote=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-size = 50%,100%
quick-terminal-screen = main
quick-terminal-animation-duration = 0.075
quick-terminal-autohide = true
quick-terminal-space-behavior = move

# Familiar WezTerm leader keys. Cmd-based Ghostty defaults remain available.
# Sequences wait for the next key; Escape cancels and Ctrl+A twice sends Ctrl+A.
keybind = ctrl+a>escape=ignore
keybind = ctrl+a>ctrl+a=text:\x01
keybind = ctrl+a>shift+backslash=new_split:right
keybind = ctrl+a>minus=new_split:down
keybind = ctrl+a>h=goto_split:left
keybind = ctrl+a>j=goto_split:down
keybind = ctrl+a>k=goto_split:up
keybind = ctrl+a>l=goto_split:right
keybind = ctrl+a>z=toggle_split_zoom
keybind = ctrl+a>x=close_surface
keybind = ctrl+a>c=new_tab
# Resize one step per sequence, or use Cmd+Ctrl+arrows repeatedly.
keybind = ctrl+a>r>h=resize_split:left,3
keybind = ctrl+a>r>j=resize_split:down,3
keybind = ctrl+a>r>k=resize_split:up,3
keybind = ctrl+a>r>l=resize_split:right,3
keybind = ctrl+a>r>escape=ignore
keybind = ctrl+a>equal=equalize_splits
